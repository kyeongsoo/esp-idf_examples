# ----------- ESP-IDF Specific -----------
# Build directory containing binaries, object files, and build maps
build/
*build*/

# auto-generated folders
managed_components/

# Generated local configuration (Do NOT track this)
sdkconfig

# Old/backup configuration files generated by menuconfig
sdkconfig.old

# ----------- Python & Tooling -----------
# Python cache files generated during the build process
__pycache__/
*.pyc
*.pyo
*.pyd
**/.ipynb_checkpoints/

# ----------- Ipe -----------
*.autosave.ipe

# Local virtual environments if managed inside the project folder
.venv/
env/
venv/

# ----------- IDEs and Editors -----------
# VS Code
.vscode/
# Exception: Un-comment the line below if you want to share launch/task configs
# !.vscode/launch.json

# CLion / CMake
.idea/
cmake-build-*/

# Eclipse / Espressif IDE
.project
.cproject
.settings/

# ----------- OS & System Files -----------
.DS_Store
Thumbs.db
